{
  "name": "@dsh-tui-ecosystem/example-plugin",
  "version": "0.1.0",
  "description": "Example dsh-TUI ecosystem plugin: per-session turn counters via log-only session events, plus an optional TUI prompt slot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tui-ecosystem/plugin-template.git"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./events": {
      "types": "./lib/types/events.d.ts",
      "import": "./lib/types/events.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "dsh-plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
